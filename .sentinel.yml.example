version: 1
engine: "auto" # auto | external | embedded
scanners:
  sast:
    enabled: true
    ruleset: "auto"
    extra_rules:
      - "rules/sast-rules.yml"
  secrets:
    enabled: true
    scan_history: false
  sca:
    enabled: true
    fail_on_license:
      - "GPL-3.0"
  iac:
    enabled: true
  dast:
    enabled: false
    target: "" # e.g. "https://api.mycorp.internal"
    allowlist:
      - "api.mycorp.internal"
    allow_private: false
  resilience:
    enabled: true

ignore:
  paths:
    - "vendor/**"
    - "node_modules/**"
    - "dist/**"
    - "build/**"
    - ".git/**"
    - "**/.sentinel/**"
    - "**/*_test.go"
  findings:
    - id: "SENT-legacy-001"
      reason: "Accepted legacy risk pending Q2 migration; tracked in SEC-402"
      expires: "2027-01-31"

thresholds:
  fail_on: "high"

output:
  formats:
    - "terminal"
    - "sarif"
    - "markdown"
  path: ".sentinel/reports/"

cloud:
  enabled: false
  endpoint: ""
