# ==========================================
# Sentinel DevSecOps Scanner - Git Ignore
# ==========================================

# Binaries and compiled outputs
bin/
dist/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Downloaded scanner engine binaries
plugins/gitleaks*
plugins/osv-scanner*
plugins/trivy*
plugins/nuclei*
plugins/semgrep*


# Node dependencies & artifacts
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
extension-vscode/dist/

# Sentinel runtime local history & reports
**/.sentinel/
*.sarif
*.cdx.json
summary.md

# Environment variables & local secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Terraform local state
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Python cache & virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
ENV/

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS temporary files
.DS_Store
Thumbs.db
desktop.ini
task.md
