# ==========================================
# Sentinel DevSecOps Scanner - Git Ignore
# ==========================================

# Binaries and compiled outputs
bin/
dist/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Node dependencies & artifacts
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
extension-vscode/dist/

# Sentinel runtime local history & reports
.sentinel/history.db
.sentinel/reports/
results.sarif
summary.md

# Environment variables & local secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Terraform local state
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Python cache & virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
ENV/

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS temporary files
.DS_Store
Thumbs.db
desktop.ini
